<div class="card">
  <div class="card-header">
    <h1 class="card-title">Order Details</h1>
  </div>
  <div class="card-body">
    <p>Status: <%= @order.status %></p>
    <p>Placed by: <%= @order.user.full_name %></p>
    <p>Email: <%= @order.user.email %></p>
    <h2>Ordered Items:</h2>
    <ul>
      <% @order.order_items.each do |order_item| %>
        <li>
          <%= order_item.item.title %>
          <div class="row">
            <div class="col-md-6">
              Quantity: <%= order_item.quantity %>
            </div>
            <div class="col-md-6 text-right">
              Subtotal: <%= number_to_currency(order_item.unit_price * order_item.quantity) %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
    <p class="mt-2"><strong>Total: <%= number_to_currency(@order.subtotal) %></strong></p>
    <p>Ordered at: <%= @order.created_at %></p>
  </div>
</div>
