
<% @orders.group_by(&:status).each do |status, orders| %>
  <h2><%= status.capitalize %> (Total: <%= orders.size %>)</h2>
  
  <div class="row">
    <% orders.each do |order| %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-header">
            Order ID: <%= order.id %> <%= link_to "View Order", order_path(order), class: "btn btn-warning float-right" %>
            <% if current_user.admin? %>
              <% if order.status == "ordered" || order.status == "paid" %>
                <%= link_to "Cancel", cancel_order_path(order), method: :patch, class: "btn btn-danger float-right mr-2" %>
              <% end %>
              <% if order.status == "ordered" %>
                <%= link_to "Mark as Paid", mark_as_paid_order_path(order), method: :patch, class: "btn btn-success float-right mr-2" %>
              <% end %>
              <% if order.status == "paid" %>
                <%= link_to "Mark as Completed", mark_as_completed_order_path(order), method: :patch, class: "btn btn-success float-right mr-2" %>
              <% end %>
            <% end %>
          </div>
          <div class="card-body">
            <p><strong>Status:</strong> <%= order.status %></p>
            <p><strong>Subtotal:</strong> <%= number_to_currency(order.subtotal, unit: ' PKR ') %></p>
            <p><strong>Items Ordered:</strong></p>
            <ul>
              <% order.order_items.each do |order_item| %>
                <li><%= order_item.quantity %> x <%= order_item.item.title %> - <%= number_to_currency(order_item.total, unit: ' PKR ') %></li>
              <% end %>
            </ul>
            <p><strong>Total:</strong><%= number_to_currency(order.subtotal, unit: ' PKR ') %></p>
            <!-- Add more order details here if needed -->
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
