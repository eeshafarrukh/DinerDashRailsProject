<nav class="navbar navbar-expand-lg navbar-custom">
  <div class="container">
    <%= link_to root_path, class: 'navbar-brand' do %>
      <%= image_tag 'logo.png', alt: 'Restaurant Logo', class: 'logo-img' %>
    <% end %>

    <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item <%= 'active' if current_page?(root_path) %>">
          <%= link_to 'Home', root_path, class: 'nav-link' %>
        </li>
        <li class="nav-item <%= 'active' if current_page?(menu_path) %>">
          <%= link_to 'Menu', menu_path, class: 'nav-link' %>
        </li>
        <li class="nav-item <%= 'active' if current_page?(cart_path) %>">
          <%= link_to 'Cart', cart_path, class: 'nav-link' %>
        </li>
      </ul>
    </div>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav">
      <% if user_signed_in? %>
        <li class="nav-item user<%= 'active' if current_page?(destroy_user_session_path) %>">
          <%= link_to 'Logout', destroy_user_session_path, method: :delete, class: 'nav-link' %>
        </li>
      <% else %>
        <li class="nav-item user <%= 'active' if current_page?(new_user_registration_path) %>">
          <%= link_to 'Sign Up', new_user_registration_path, class: 'nav-link' %>
        </li>
        <li class="nav-item user <%= 'active' if current_page?(new_user_session_path) %>">
          <%= link_to 'Login', new_user_session_path, class: 'nav-link' %>
        </li>
      <% end %>
    </ul>
    </div>
  </div>
</nav>
