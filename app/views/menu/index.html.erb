<%= javascript_include_tag 'ajax_form_submit' %> <!-- Include the JavaScript file -->

<div class="container menu-page">
  <% if current_user&.admin? %>
    <%= link_to "Create New Item", new_item_path, class: "btn btn-warning" %>
    <%= link_to "Create New Category", new_category_path, class: "btn btn-warning" %>
  <% end %>
  <div class="container">
    <% @categories.each do |category| %>
      <div class="row mt-4">
        <div class="col">
          <h3><%= category.name %></h3>
          <div class="row">
            <% category.items.each do |item| %>
              <% if (!item.retired || current_user&.admin?) %>
                <div class="col-md-5 mb-5<%= ' retired-item' if item.retired %>">
                  <div class="card outline-custom">
                    <div class="card-header">
                      <h5 class="mb-0"><%= item.title %></h5>

                    </div>
                     <%= link_to "View Item", item_path(item), class: "btn btn-warning" %>
                    <div class="card-body">
                      <p class="card-text"><%= item.description %></p>
                      <p class="card-text">Price: <%= number_to_currency(item.price, unit: 'PKR ') %></p>
                     
                      <%= form_with(url: cart_add_path, local: true, remote: true) do |f| %>
                        <div class="input-group mb-3">
                          <%= f.hidden_field :id, value: item.id %>
                          <%= f.number_field :quantity, value: 1, min: 1, class: "form-control" %>
                          <div class="input-group-append">
                            <%= f.submit "Add to Cart", class: "btn btn-warning" %>
                          </div>
                        </div>
                      <% end %>
                      <% if current_user&.admin? %>
                        <%= link_to "Edit Item", edit_item_path(item), class: "btn btn-warning" %>
                        <%= link_to item.retired ? 'Item Retired' : 'Retire Item',
                                    retire_item_path(item), method: :patch,
                                    class: "btn btn-danger #{'disabled' if item.retired}" %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%= render partial: "cart/cart" if @render_cart === true %>
</div>
