<% @cart.orderables.each do |orderable| %>
	<% item= orderable.item %>
	<div id=" <%= "cart-#{item.id}" %>"class="container menu-page">
	  <div class="container">
	   
	      <div class="row mt-4">
	        <div class="col">
	        
	          <div class="row">
	            
	              <div class="col-md-8 mb-4"> <!-- Increased width to col-md-6 -->
	                <div class="card outline-custom">
	                  <div class="card-header">
	                    <h5 class="mb-0"><%= item.title %></h5>
	                  </div>
	                  <div class="card-body">
	                    <p class="card-text"><%= item.description %></p>
	                    <p class="card-text">Price: <%= number_to_currency(item.price) %></p>
	                    <%= form_with(url: cart_add_path, local: true) do |f| %>
	                      <div class="input-group mb-3">
	                        <%= f.hidden_field :id, value: item.id %>
	                        <%= f.number_field :quantity, value: orderable.quantity, min: 0, class: "form-control" %>
	                        <div class="input-group-append">
	                          <%= f.submit "Update", class: "btn btn-warning" %>
	                        </div>
	                      </div>
	                    <% end %>
	                     <%= form_with(url: cart_remove_path, local: true) do |f| %>
	                      <div class="input-group mb-3">
	                        <%= f.hidden_field :id, value: orderable.id %>
	                  
	                        <div class="input-group-append">
	                          <%= f.submit "Remove", class: "btn btn-warning" %>
	                        </div>
	                      </div>
	                    <% end %>
	                    <strong>Total:</strong>
	                    <%=orderable.total%>
	                  </div>
	                </div>
	              </div>
	        
	          </div>
	        </div>
	      </div>
	   
	  </div>
	  <!-- ... your existing content ... -->
</div>

<% end %>