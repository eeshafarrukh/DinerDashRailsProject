<div class="card">
  <div class="card-header">
    <h1 class="card-title">Cart</h1>
  </div>
  <div class="card-body">
    <% if @cart.orderables.count > 0 %>
      <div class="cart-orderables">
        <%= render "cart/orderables" %>
      </div>
      <div class="cart-total">
        <h3 class="d-flex justify-content-start">Total: <%= number_to_currency(@cart.total, unit: ' PKR ') %></h3>
        <div class="d-flex justify-content-end">
      <%= link_to "Checkout", cart_checkout_path, method: :post, class: "btn btn-warning float-right" %>
   

      </div>
      </div>
      
    <% else %>
      <p class="card-text">Your cart is empty</p>
    <% end %>
  </div> 
</div>
